{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with connected game account, role, balance, and status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "id": { "type": "string" },
        "gameAccountId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["player", "admin"] },
        "balance": { "type": "number" },
        "accountStatus": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "FROZEN", "BLOCKED"] },
        "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "violationCount": { "type": "number" },
        "illicitActivityFlags": { "type": "array", "items": { "type": "string" } },
        "gameSessionStatus": { "type": "string" },
        "vipTier": { "type": "string" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastSignIn": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "DepositRequest": {
      "title": "DepositRequest",
      "description": "Manual UPI deposit request submitted by players for administrator verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "playerId": { "type": "string" },
        "username": { "type": "string" },
        "amount": { "type": "number" },
        "utr": { "type": "string" },
        "screenshotUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "playerId", "amount", "utr", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents keyed by Auth UID"
    },
    "/deposit_requests/{depositId}": {
      "schema": "DepositRequest",
      "description": "Manual deposit requests submitted by players"
    }
  }
}
